# Discord: token required; deployment card channel optional
DISCORD_API_KEY=
DISCORD_CHANNEL_ID=

# Core logging and deployment metadata
DEFAULT_LOGGER=default
BRANCH=main
ENV=dev
TZ=Europe/London

# Booru: Safebooru needs no credentials
IMAGE_PROVIDER=safebooru
GELBOORU_SFW=true
# Both credentials required when IMAGE_PROVIDER=gelbooru
GELBOORU_API_KEY=
GELBOORU_USER_ID=
ALLOW_AI_IMAGES=false

# AI chat: enable a provider only after setting its API key
# OpenAI takes precedence when both providers are active
OPENAI_API_KEY=
OPENAI_ACTIVE=false
OPENAI_MODEL=gpt-4o
GOOGLEAI_API_KEY=
GOOGLEAI_ACTIVE=false
GOOGLEAI_MODEL=gemini-2.5-flash-lite
GOOGLEAI_IMAGE_MODEL=gemini-2.5-flash-image-preview

# QuoteDB: credentials required for /quote commands
QUOTEDB_URL=https://quotes.elmu.dev/api/v1/quotes
QUOTEDB_API_KEY=
QUOTEDB_USER_ID=

# Pterodactyl: database stored under data/; retain the key with the database
SERVER_DATABASE=pterodactyl.db
# Generate once with: openssl rand -hex 32 (64 hex characters)
ENCRYPTION_KEY=
# Optional comma-separated panel hostnames, without schemes or paths
PTERODACTYL_ALLOWED_HOSTS=

# TikTok: leave username empty to disable monitoring
# When enabled, set display name and comma-separated channel IDs (no spaces)
TIKTOK_USERNAME=
TIKTOK_LIVE_CHANNEL_IDS=
LIVE_DISPLAY_NAME=
LIVE_START_TIME=15
LIVE_END_TIME=18
# Leave link switches empty to disable; even the string "false" enables them
TWITCH_STREAM=
TWITCH_USERNAME=
INSTA_STREAM=
INSTA_USERNAME=
